# Copy to .env.local (git-ignored) for local use, and add the same names in Vercel > Project > Settings >
# Environment Variables. NEVER put a real key in this file or in any file that is committed.

# Required for live Nova. Without it Nova answers from the preset demo answers.
NOVA_API_KEY=

# Optional. Defaults: Groq's OpenAI-compatible endpoint and model. Any OpenAI-compatible provider works.
# NOVA_API_URL=https://api.groq.com/openai/v1/chat/completions
# NOVA_MODEL=qwen/qwen3.8-27b   (models get retired: run `npm run nova:diagnose` to list the ones your key can use)
